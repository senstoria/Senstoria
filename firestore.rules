rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'senstoria@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.keys().hasAll(['id', 'email', 'role'])
                    && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id']))
                    || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Perfumes Catalog (Publicly readable, Admin write)
    match /perfumes/{perfumeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bottles Collection (Private to user)
    match /bottles/{bottleId} {
      allow get: if isOwner(resource.data.user_id) || isAdmin();
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.size_ml > 0
                    && request.resource.data.remaining_ml >= 0
                    && request.resource.data.remaining_ml <= request.resource.data.size_ml;
      allow update: if isOwner(resource.data.user_id)
                    && request.resource.data.remaining_ml >= 0
                    && request.resource.data.remaining_ml <= request.resource.data.size_ml;
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // Wear Logs
    match /wear_logs/{wearId} {
      allow get: if isOwner(resource.data.user_id) || isAdmin();
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // Scent Stories
    match /scent_stories/{storyId} {
      allow get: if isOwner(resource.data.user_id) || (resource.data.status == 'published') || isAdmin();
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow get: if resource.data.status == 'approved' || (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
    }

    // Waitlist Entries
    match /waitlist_entries/{waitlistId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() > 3;
      allow get, list, update, delete: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
    }

    // Sample Orders (Flagged checkout)
    match /sample_orders/{orderId} {
      allow create: if request.resource.data.order_number is string;
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Affiliate Clicks
    match /affiliate_clicks/{clickId} {
      allow create: if request.resource.data.click_id is string;
      allow read, update, delete: if isAdmin();
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
