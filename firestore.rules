rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all (kept: specific allows below are OR-ed with it).
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin ONLY via Firebase custom claim `admin: true` (§5.4 bootstrap).
    // The previous hard-coded admin email and the `admins` collection are gone.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // A document is owned by the caller when its stored user_id matches.
    // For creates, the incoming document must carry the caller's uid.
    function ownedData() {
      return resource.data.user_id == request.auth.uid;
    }

    function ownedIncoming() {
      return request.resource.data.user_id == request.auth.uid;
    }

    // Users — owner-only profile, never public. No birth date is ever
    // stored: client writes of any birth-date field are forbidden.
    // (The 18+ age gate and its `birthdate_verified_18plus` requirement
    // were removed by founder decision, 30 Oct 2026.)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.consent_version is string
                    && !request.resource.data.keys().hasAny(['birth_date', 'birthDate', 'date_of_birth', 'dob', 'birthdate'])
                    && !request.resource.data.keys().hasAny(['role', 'isAdmin']);
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent_version', 'consent_at', 'email'])
                    && !request.resource.data.keys().hasAny(['birth_date', 'birthDate', 'date_of_birth', 'dob', 'birthdate', 'role', 'isAdmin'])
                    || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Perfumes catalog — public read ONLY for published rows (Sprint 3 seed).
    // Drafts/verified rows are invisible to everyone except admins.
    match /perfumes/{perfumeId} {
      allow get: if resource.data.data_status == 'published' || isAdmin();
      allow list: if resource.data.data_status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Brands — public reference data, admin write.
    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Perfume offers — public commerce data, admin write. Read by /go (Sprint 2).
    match /perfume_offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Bottles — private to the owner. BR-01: bottle record is the only source
    // for % remaining / counts / valuation, so bounds are enforced here.
    // P0 Admin v1: user_id TIDAK BISA PINDAH — update harus membawa
    // user_id yang sama dengan dokumen lama. Berlaku juga untuk admin:
    // admin tidak boleh memindahkan bottle ke pemilik lain. (Dulu hanya
    // ownedData() yang dicek, yaitu user_id LAMA, sehingga pemilik bisa
    // menulis user_id baru = UID orang lain.)
    match /bottles/{bottleId} {
      allow get: if ownedData() || isAdmin();
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && ownedIncoming()
                    && request.resource.data.size_ml is number
                    && request.resource.data.size_ml > 0
                    && request.resource.data.remaining_ml is number
                    && request.resource.data.remaining_ml >= 0
                    && request.resource.data.remaining_ml <= request.resource.data.size_ml
                    && request.resource.data.status in ['in_use', 'sealed', 'finished'];
      allow update: if request.resource.data.user_id == resource.data.user_id
                    && ((ownedData()
                         && request.resource.data.remaining_ml is number
                         && request.resource.data.remaining_ml >= 0
                         && request.resource.data.remaining_ml <= request.resource.data.size_ml
                         && request.resource.data.status in ['in_use', 'sealed', 'finished'])
                        || isAdmin());
      allow delete: if ownedData() || isAdmin();
    }

    // Wear logs — the only wear events (BR-01). Owner-only.
    // P0 Admin v1: update TIDAK BOLEH mengubah user_id, bottle_id,
    // perfume_id, atau sprays. Bukti tidak ada alur sah yang mengubah
    // field-field itu: satu-satunya update wear_logs di kode adalah
    // softDeleteWearLogDoc / restoreWearLogDoc (dataLayer.ts) yang
    // hanya mengubah deleted_at; semua tulis lain adalah create
    // (logWearTransaction tx.set + saveWearLogToFirestore setDoc) dan
    // delete (retractWearLogTransaction). WearTimer
    // (components/WearTimer.tsx) hanya membaca worn_at untuk menampilkan
    // jam — tidak menulis apa pun. Jadi keempat field dibekukan untuk
    // pemilik MAUPUN admin; update sah hari ini hanya deleted_at
    // (soft-delete/restore). Catatan: ml_used / worn_at / client_op_id
    // masih bisa diubah pemilik — tidak ada UI yang melakukannya hari
    // ini; pembekuan penuh (affectedKeys hanya deleted_at) ditunda ke
    // hardening berikutnya agar tidak memecahkan setDoc re-save.
    // Create sudah mengikat user_id == auth.uid (ownedIncoming()).
    match /wear_logs/{wearId} {
      allow get: if ownedData() || isAdmin();
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && ownedIncoming()
                    && request.resource.data.bottle_id is string
                    && request.resource.data.perfume_id is string
                    && request.resource.data.client_op_id is string
                    && request.resource.data.sprays is int
                    && request.resource.data.sprays >= 1;
      allow update: if request.resource.data.user_id == resource.data.user_id
                    && request.resource.data.bottle_id == resource.data.bottle_id
                    && request.resource.data.perfume_id == resource.data.perfume_id
                    && request.resource.data.sprays == resource.data.sprays
                    && (ownedData() || isAdmin());
      allow delete: if ownedData() || isAdmin();
    }

    // Scent Stories — Journal is PRIVATE in Stage 1 (BR-05). No public reads,
    // no published-story path. Stories can never be made public from the client.
    // P0 Admin v1: user_id tidak bisa pindah (juga untuk admin), dan
    // larangan is_published == true kini berlaku untuk admin juga —
    // sebelumnya cabang isAdmin() membebaskan segalanya, termasuk
    // membuat cerita privat menjadi publik. Create sudah mengikat
    // user_id == auth.uid (ownedIncoming()).
    match /scent_stories/{storyId} {
      allow get: if ownedData() || isAdmin();
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && ownedIncoming()
                    && request.resource.data.body is string
                    && (!request.resource.data.keys().hasAny(['is_published']) || request.resource.data.is_published == false);
      allow update: if request.resource.data.user_id == resource.data.user_id
                    && (!request.resource.data.keys().hasAny(['is_published']) || request.resource.data.is_published == false)
                    && (ownedData() || isAdmin());
      allow delete: if ownedData() || isAdmin();
    }

    // Reviews — aggregates only from approved + n>=5 (REV-03, enforced in code).
    // Clients can never self-approve: creates must be pending with zero helpful votes.
    match /reviews/{reviewId} {
      allow get: if resource.data.status == 'approved' || ownedData() || isAdmin();
      allow list: if resource.data.status == 'approved'
                  || (isSignedIn() && resource.data.user_id == request.auth.uid)
                  || isAdmin();
      allow create: if isSignedIn() && ownedIncoming()
                    && request.resource.data.perfume_id is string
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.status == 'pending_moderation'
                    && (!request.resource.data.keys().hasAny(['helpful_count']) || request.resource.data.helpful_count == 0);
      allow update: if isAdmin()
                    || (ownedData()
                        && resource.data.status == 'pending_moderation'
                        && request.resource.data.status == 'pending_moderation'
                        && (!request.resource.data.keys().hasAny(['helpful_count']) || request.resource.data.helpful_count == resource.data.helpful_count));
      allow delete: if ownedData() || isAdmin();
    }

    // Waitlist entries — NO client writes. Server Function only (Sprint 4,
    // double opt-in). Admins may read for fulfilment.
    match /waitlist_entries/{waitlistId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Sample orders — no client writes (payment simulator is deleted in Sprint 4).
    match /sample_orders/{orderId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Affiliate clicks — server-written only (Sprint 2 /go Function).
    // Client writes are denied so counts cannot be forged.
    match /affiliate_clicks/{clickId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Alur status pesanan Fase N12: Baru → Dibayar → Dikirim → Selesai
    // / Batal. Batal hanya dari Baru/Dibayar; tidak ada jalan kembali
    // dari Selesai/Batal.
    function isValidOrderTransition(oldStatus, newStatus) {
      return (oldStatus == 'baru' && newStatus in ['dibayar', 'batal'])
          || (oldStatus == 'dibayar' && newStatus in ['dikirim', 'batal'])
          || (oldStatus == 'dikirim' && newStatus == 'selesai');
    }

    // Orders (Fase N12, gerbang S3) — pesanan full-size. Pembeli hanya
    // baca pesanannya sendiri; buat hanya dengan status 'baru' + user_id
    // sendiri + provider Midtrans + total akhir yang nyata (total >=
    // subtotal, karena ongkir >= 0). Batalkan sendiri hanya dari
    // 'baru'/'dibayar' dan hanya mengubah status + stempel batal +
    // alasan. Admin boleh memajukan status mengikuti alur Baru →
    // Dibayar → Dikirim → Selesai / Batal dan menulis nomor resi +
    // id transaksi Midtrans. Tidak ada client write lain.
    match /orders/{orderId} {
      allow get: if ownedData() || isAdmin();
      allow list: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && ownedIncoming()
                    && request.resource.data.status == 'baru'
                    && request.resource.data.payment_provider == 'midtrans'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.subtotal_idr is number
                    && request.resource.data.subtotal_idr > 0
                    && request.resource.data.total_idr is number
                    && request.resource.data.total_idr >= request.resource.data.subtotal_idr;
      allow update: if isAdmin()
                    && ((isValidOrderTransition(resource.data.status, request.resource.data.status)
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at', 'paid_at', 'shipped_at', 'cancelled_at', 'tracking_number', 'midtrans_transaction_id']))
                        || (request.resource.data.status == resource.data.status
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tracking_number', 'updated_at'])))
                    || (ownedData()
                        && resource.data.status in ['baru', 'dibayar']
                        && request.resource.data.status == 'batal'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at', 'cancelled_at', 'cancel_reason']));
      allow delete: if isAdmin();
    }

    // Shared Stories (Fase N13, P11) — berbagi satu Scent Story
    // opt-in lewat tautan `/s/<token>`. Id dokumen ADALAH token acak:
    // baca publik hanya per-dokumen (get), TANPA list. Pemilik hanya
    // baca daftar miliknya; admin baca semua. Buat hanya dengan token
    // yang sama dengan id dokumen, isi >= 20 karakter, revoked false,
    // report_count 0. Berhenti bagikan satu arah: pemilik hanya bisa
    // revoked false → true (tidak bisa mengaktifkan lagi). Laporan
    // publik hanya menaikkan report_count +1 dan reported_at pada
    // tautan aktif — laporan TIDAK PERNAH mencabut tautan.
    match /shared_stories/{token} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && ownedIncoming()
                    && request.resource.data.token == token
                    && request.resource.data.story_id is string
                    && request.resource.data.perfume_id is string
                    && request.resource.data.perfume_brand is string
                    && request.resource.data.perfume_name is string
                    && request.resource.data.body is string
                    && request.resource.data.body.size() >= 20
                    && request.resource.data.revoked == false
                    && request.resource.data.report_count == 0
                    && (request.resource.data.display_name == null || request.resource.data.display_name is string);
      allow update: if isAdmin()
                    || (ownedData()
                        && resource.data.revoked == false
                        && request.resource.data.revoked == true
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revoked_at', 'updated_at']))
                    || (resource.data.revoked == false
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['report_count', 'reported_at'])
                        && request.resource.data.report_count == resource.data.report_count + 1);
      allow delete: if isAdmin();
    }

    // Wishlist & compare — per-account subcollections (Sprint 2, BR-03).
    // Never bottle records, never counted as owned. Owner-only CRUD;
    // the item id is the perfume id, enforced in code (compare max 3).
    match /wishlist/{userId}/items/{perfumeId} {
      allow read, write: if isOwner(userId);
    }

    match /compare/{userId}/items/{perfumeId} {
      allow read, write: if isOwner(userId);
    }

    // Feature flags — admin only. Never readable by the public client.
    match /feature_flags/{flagId} {
      allow read, write: if isAdmin();
    }

    // Admin audit log (Admin v1 P0, spek §3.5/§4) — append-only.
    // Hanya admin yang boleh membaca dan membuat; TIDAK ADA update /
    // delete dari client mana pun, termasuk admin. Aktor terikat ke
    // pemanggil (actor_uid == auth.uid) supaya satu admin tidak bisa
    // memalsukan entri atas nama orang lain. created_at ditulis
    // serverTimestamp oleh logAdminAction (src/lib/adminAudit.ts);
    // rules tidak mengikat nilainya karena stempel server tidak bisa
    // dipalsukan dari client. Retensi log belum diputuskan founder
    // (spek §13 Q10) — sampai diputuskan, log tidak dihapus.
    match /admin_actions/{actionId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actor_uid == request.auth.uid
                    && request.resource.data.action is string
                    && request.resource.data.target_type is string
                    && request.resource.data.target_id is string
                    && request.resource.data.result is string;
      allow update, delete: if false;
    }
  }
}
